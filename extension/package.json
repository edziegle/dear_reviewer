    "configuration": {
      "title": "Dear Reviewer",
      "properties": {
        "dearReviewer.repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "default": [],
          "markdownDescription": "More GitHub repositories, as `owner/name`, whose pull requests feed the Dashboard. You rarely need this: every folder you have open that is a clone of a GitHub repository adds that repository by itself, and Dear Reviewer remembers it for the review window."
        },
        "dearReviewer.localClones": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Where a repository is cloned on this machine, as `\"owner/name\": \"/path/to/clone\"`, when it isn't a folder you open. Takes precedence over clones Dear Reviewer found or remembered. Opening a pull request fetches its head into the clone, from the remote whose URL names the repository (or `origin`), and reviews it in worktrees of the clone. The Dashboard also lists the clone's local branches that are ahead of its main branch.",
          "scope": "machine"
        },
        "dearReviewer.autoRefreshChanges": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check an open pull request's Change against GitHub when the window regains focus, and bring in its new commits and review threads. Off, a Change stays as you opened it until you run **Fetch Updates**."
        },
        "dearReviewer.githubApiUrl": {
          "type": "string",
          "default": "https://api.github.com",
          "markdownDescription": "The GitHub API base URL. For GitHub Enterprise Server, use `https://<host>/api/v3`.",
          "scope": "application"
        },
        "dearReviewer.visitSkimOnlyFiles": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Let **Next Unviewed File** and **Previous Unviewed File** stop at skim-only files: lock files, files the base commit marks `linguist-generated`, renames with no edits, and files that were only reformatted. Off, they skip these files until nothing else is left to view."
        },
        "dearReviewer.claudeCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "The command that starts `claude` for the Assistant: the program, then its arguments, such as `[\"/opt/homebrew/bin/claude\"]` or `[\"docker\", \"exec\", \"-i\", \"my-box\", \"claude\"]`. Dear Reviewer adds its own arguments after yours and runs the command without a shell. Leave empty to use the `claude` on the PATH or in a usual install location. The Assistant uses whichever Claude login this `claude` has; sign in by running `claude` in a terminal. [What a custom command must do](https://github.com/edziegle/dear_reviewer/wiki/custom-claude-command).",
          "scope": "machine"
        },
        "dearReviewer.claudePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `claude` executable the Assistant runs, such as `/opt/homebrew/bin/claude`. Used as a command of one item while Claude Command is empty.",
          "markdownDeprecationMessage": "**Deprecated**: use [Claude Command](command:workbench.action.openSettings?%5B%22dearReviewer.claudeCommand%22%5D) instead. It takes arguments too.",
          "scope": "machine"
        }
      }
    },
    "colors": [
      {
        "id": "dearReviewer.assistantForeground",
        "description": "The Assistant's color: the rule down its replies, its take and its Reading Order, its mark, and its Findings in the editor.",
        "defaults": {
          "dark": "charts.purple",
          "light": "charts.purple",
          "highContrast": "charts.purple",
          "highContrastLight": "charts.purple"
        }
      }
    ],
    "icons": {
      "dear-reviewer-logo": {
        "description": "The Dear Reviewer logo",
        "default": {
          "fontPath": "media/dear-reviewer-logo.woff",
          "fontCharacter": "\\E000"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dearReviewer",
          "title": "Dear Reviewer",
          "icon": "media/dear-reviewer.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dearReviewerAssistant",
          "title": "Assistant",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "dearReviewerAssistant": [
        {
          "type": "webview",
          "id": "dearReviewer.assistant",
          "name": "Assistant"
        }
      ],
      "dearReviewer": [
        {
          "type": "webview",
          "id": "dearReviewer.dashboard",
          "name": "Dashboard",
          "when": "!dearReviewer.inReviewWindow"
        },
        {
          "id": "dearReviewer.changeFiles",
          "name": "Change Files",
          "size": 5,
          "when": "dearReviewer.inReviewWindow || dearReviewer.hasOpenChange"
        },
        {
          "id": "dearReviewer.findings",
          "name": "Findings",
          "size": 1,
          "when": "dearReviewer.inReviewWindow || dearReviewer.hasOpenChange"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dearReviewer.refreshInbox",
          "when": "view == dearReviewer.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "dearReviewer.addRepository",
          "when": "view == dearReviewer.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "dearReviewer.forgetRepository",
          "when": "view == dearReviewer.dashboard",
          "group": "repositories@1"
        },
        {
          "command": "dearReviewer.openSetup",
          "when": "view == dearReviewer.dashboard",
          "group": "setup@1"
        },
        {
          "command": "dearReviewer.openReviewTools",
          "when": "view == dearReviewer.dashboard",
          "group": "setup@2"
        },
        {
          "command": "dearReviewer.openReviewTools",
          "when": "view == dearReviewer.changeFiles",
          "group": "help@1"
        },
        {
          "command": "dearReviewer.showTimeline",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hasOpenChange",
          "group": "navigation@1"
        },
        {
          "command": "dearReviewer.showCodeFlow",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hasOpenChange",
          "group": "navigation@2"
        },
        {
          "command": "dearReviewer.fetchUpdates",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hasOpenChange",
          "group": "navigation@8"
        },
        {
          "command": "dearReviewer.refreshChangeFiles",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hasOpenChange",
          "group": "navigation@9"
        },
        {
          "command": "dearReviewer.hideViewedFiles",
          "when": "view == dearReviewer.changeFiles && !dearReviewer.hideViewedFiles && dearReviewer.hasOpenChange",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.showViewedFiles",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hideViewedFiles && dearReviewer.hasOpenChange",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.sortByReadingOrder",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hasReadingOrder && dearReviewer.changeFilesSortBy == tree",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.sortByTree",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hasReadingOrder && dearReviewer.changeFilesSortBy == readingOrder",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.findIssues",
          "when": "view == dearReviewer.findings && dearReviewer.hasOpenChange",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dearReviewer.openPullRequest",
          "when": "false"
        },
        {
          "command": "dearReviewer.openLocalBranch",
          "when": "false"
        },
        {
          "command": "dearReviewer.openChangeFile",
          "when": "false"
        },
        {
          "command": "dearReviewer.markViewed",
          "when": "false"
        },
        {
          "command": "dearReviewer.markViewedAndClose",
          "when": "false"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "false"
        },
        {
          "command": "dearReviewer.hideViewedFiles",
          "when": "!dearReviewer.hideViewedFiles"
        },
        {
          "command": "dearReviewer.showViewedFiles",
          "when": "dearReviewer.hideViewedFiles"
        },
        {
          "command": "dearReviewer.sortByReadingOrder",
          "when": "dearReviewer.changeFilesSortBy == tree"
        },
        {
          "command": "dearReviewer.sortByTree",
          "when": "dearReviewer.changeFilesSortBy == readingOrder"
        },
        {
          "command": "dearReviewer.suggestReadingOrder",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.addComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.startReview",
          "when": "false"
        },
        {
          "command": "dearReviewer.addToReview",
          "when": "false"
        },
        {
          "command": "dearReviewer.replyToThread",
          "when": "false"
        },
        {
          "command": "dearReviewer.resolveThread",
          "when": "false"
        },
        {
          "command": "dearReviewer.unresolveThread",
          "when": "false"
        },
        {
          "command": "dearReviewer.editComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.addAgentNote",
          "when": "false"
        },
        {
          "command": "dearReviewer.saveComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.cancelEditComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.deleteComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.sendSelectionToAssistant",
          "when": "editorIsOpen && (resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// || resourceScheme == dear-reviewer-commit)"
        },
        {
          "command": "dearReviewer.askAssistant",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.copyBrief",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/briefs\\//"
        },
        {
          "command": "dearReviewer.convertFinding",
          "when": "dearReviewer.hasFindings"
        },
        {
          "command": "dearReviewer.dismissFinding",
          "when": "dearReviewer.hasFindings"
        },
        {
          "command": "dearReviewer.revealFinding",
          "when": "false"
        },
        {
          "command": "dearReviewer.submitReview",
          "when": "dearReviewer.hasOpenChange && dearReviewer.frontIsPullRequest"
        },
        {
          "command": "dearReviewer.viewOnGitHub",
          "when": "dearReviewer.hasOpenChange && dearReviewer.frontIsPullRequest"
        },
        {
          "command": "dearReviewer.writeBrief",
          "when": "dearReviewer.hasOpenChange && !dearReviewer.frontIsPullRequest && dearReviewer.frontHasComments"
        },
        {
          "command": "dearReviewer.finishReview",
          "when": "false"
        },
        {
          "command": "dearReviewer.nextUnviewedFile",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.previousUnviewedFile",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.markViewedAndNext",
          "when": "dearReviewer.hasOpenChange"
        },
        {
