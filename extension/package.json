{
  "name": "dear-reviewer",
  "displayName": "Dear Reviewer",
  "description": "A workbench for reviewing Changes, with real code navigation on both sides of the diff.",
  "private": true,
  "license": "MIT",
  "version": "0.2.1",
  "publisher": "edziegle",
  "engines": {
    "vscode": "^1.135.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The GitHub API base URL, the local clones and the path to claude are only read from user settings, and the repositories of a window's folders are only read once the window is trusted.",
      "restrictedConfigurations": [
        "dearReviewer.githubApiUrl",
        "dearReviewer.claudePath",
        "dearReviewer.localClones"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "dearReviewer.openChange",
        "title": "Open Commit Range…",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.openPullRequest",
        "title": "Open Pull Request",
        "category": "Dear Reviewer",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "dearReviewer.openLocalBranch",
        "title": "Open Branch",
        "category": "Dear Reviewer",
        "icon": "$(git-branch)"
      },
      {
        "command": "dearReviewer.closeChange",
        "title": "Close Change",
        "category": "Dear Reviewer",
        "icon": "$(close)"
      },
      {
        "command": "dearReviewer.signIn",
        "title": "Sign In to GitHub",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.refreshInbox",
        "title": "Refresh Dashboard",
        "category": "Dear Reviewer",
        "icon": "$(refresh)"
      },
      {
        "command": "dearReviewer.addRepository",
        "title": "Add Repository…",
        "category": "Dear Reviewer",
        "icon": "$(add)"
      },
      {
        "command": "dearReviewer.locateClone",
        "title": "Locate Clone…",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.forgetRepository",
        "title": "Forget Repository…",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.openSetup",
        "title": "Set Up Dear Reviewer",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.trustReviewWindow",
        "title": "Trust the Review Window…",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.setToken",
        "title": "Use a GitHub Personal Access Token…",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.forgetToken",
        "title": "Forget GitHub Personal Access Token",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.openChangeFile",
        "title": "Open File",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.markViewed",
        "title": "Mark Viewed",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.markViewedAndClose",
        "title": "Mark Viewed and Close",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.unmarkViewed",
        "title": "Unmark Viewed",
        "category": "Dear Reviewer",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "dearReviewer.refreshChangeFiles",
        "title": "Refresh Change Files",
        "category": "Dear Reviewer",
        "icon": "$(refresh)"
      },
      {
        "command": "dearReviewer.hideViewedFiles",
        "title": "Hide Viewed Files",
        "category": "Dear Reviewer",
        "icon": "$(eye-closed)"
      },
      {
        "command": "dearReviewer.showViewedFiles",
        "title": "Show Viewed Files",
        "category": "Dear Reviewer",
        "icon": "$(eye)"
      },
      {
        "command": "dearReviewer.sortByReadingOrder",
        "title": "Sort by Reading Order",
        "category": "Dear Reviewer",
        "icon": "$(list-ordered)"
      },
      {
        "command": "dearReviewer.sortByTree",
        "title": "Sort as Tree",
        "category": "Dear Reviewer",
        "icon": "$(list-tree)"
      },
      {
        "command": "dearReviewer.suggestReadingOrder",
        "title": "Suggest Reading Order",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.nextUnviewedFile",
        "title": "Next Unviewed File",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.previousUnviewedFile",
        "title": "Previous Unviewed File",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.markViewedAndNext",
        "title": "Mark Viewed and Open Next",
        "category": "Dear Reviewer",
        "icon": "$(check)"
      },
      {
        "command": "dearReviewer.showAssistant",
        "title": "Show Assistant",
        "category": "Dear Reviewer",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dearReviewer.showTimeline",
        "title": "Show Overview",
        "category": "Dear Reviewer",
        "icon": "$(info)"
      },
      {
        "command": "dearReviewer.showDashboard",
        "title": "Show Dashboard",
        "category": "Dear Reviewer",
        "icon": "$(dashboard)"
      },
      {
        "command": "dearReviewer.showReviewKeys",
        "title": "Show Review Keys",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.openAllChanges",
        "title": "Open All Changes",
        "category": "Dear Reviewer",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "dearReviewer.sendSelectionToAssistant",
        "title": "Send Selection to Assistant",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.askAssistant",
        "title": "Ask the Assistant",
        "category": "Dear Reviewer",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dearReviewer.checkClaudeLogin",
        "title": "Check Claude Login",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.addComment",
        "title": "Add Comment",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.startReview",
        "title": "Start Review",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.addToReview",
        "title": "Add Review Comment",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.replyToThread",
        "title": "Reply",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.resolveThread",
        "title": "Resolve",
        "category": "Dear Reviewer",
        "icon": "$(check)"
      },
      {
        "command": "dearReviewer.unresolveThread",
        "title": "Unresolve",
        "category": "Dear Reviewer",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "dearReviewer.editComment",
        "title": "Edit Comment",
        "category": "Dear Reviewer",
        "icon": "$(edit)"
      },
      {
        "command": "dearReviewer.saveComment",
        "title": "Save",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.cancelEditComment",
        "title": "Cancel",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.deleteComment",
        "title": "Delete Comment",
        "category": "Dear Reviewer",
        "icon": "$(trash)"
      },
      {
        "command": "dearReviewer.submitReview",
        "title": "Submit Review…",
        "category": "Dear Reviewer",
        "icon": "$(check-all)"
      },
      {
        "command": "dearReviewer.discardReview",
        "title": "Discard Pending Comments…",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.writeBrief",
        "title": "Write Brief…",
        "category": "Dear Reviewer",
        "icon": "$(note)"
      },
      {
        "command": "dearReviewer.finishReview",
        "title": "Submit Review… or Write Brief…",
        "category": "Dear Reviewer",
        "icon": "$(check-all)"
      },
      {
        "command": "dearReviewer.copyBrief",
        "title": "Copy Brief",
        "category": "Dear Reviewer",
        "icon": "$(copy)"
      },
      {
        "command": "dearReviewer.showChangesSinceLastReview",
        "title": "Show Changes Since Your Last Review",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.findIssues",
        "title": "Ask for Findings",
        "category": "Dear Reviewer",
        "icon": "$(lightbulb)"
      },
      {
        "command": "dearReviewer.convertFinding",
        "title": "Convert Finding to Comment",
        "category": "Dear Reviewer",
        "icon": "$(comment)"
      },
      {
        "command": "dearReviewer.dismissFinding",
        "title": "Dismiss Finding",
        "category": "Dear Reviewer",
        "icon": "$(close)"
      },
      {
        "command": "dearReviewer.revealFinding",
        "title": "Show Finding",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.nextFinding",
        "title": "Next Finding",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.previousFinding",
        "title": "Previous Finding",
        "category": "Dear Reviewer"
      }
    ],
    "configuration": {
      "title": "Dear Reviewer",
      "properties": {
        "dearReviewer.repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "default": [],
          "markdownDescription": "More GitHub repositories, as `owner/name`, whose pull requests feed the Dashboard. You rarely need this: every folder you have open that is a clone of a GitHub repository adds that repository by itself, and Dear Reviewer remembers it for the review window."
        },
        "dearReviewer.localClones": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Where a repository is cloned on this machine, as `\"owner/name\": \"/path/to/clone\"`, when it isn't a folder you open. Takes precedence over clones Dear Reviewer found or remembered. Opening a pull request fetches its head into the clone, from the remote whose URL names the repository (or `origin`), and reviews it in worktrees of the clone. The Dashboard also lists the clone's local branches that are ahead of its main branch.",
          "scope": "machine"
        },
        "dearReviewer.githubApiUrl": {
          "type": "string",
          "default": "https://api.github.com",
          "markdownDescription": "The GitHub API base URL. For GitHub Enterprise Server, use `https://<host>/api/v3`.",
          "scope": "application"
        },
        "dearReviewer.claudePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `claude` executable the Assistant runs, such as `/opt/homebrew/bin/claude`. Leave empty to use the `claude` on the PATH or in a usual install location. The Assistant uses whichever Claude login this `claude` has; sign in by running `claude` in a terminal.",
          "scope": "machine"
        }
      }
    },
    "colors": [
      {
        "id": "dearReviewer.assistantForeground",
        "description": "The Assistant's color: the rule down its replies, its take and its Reading Order, its mark, and its Findings in the editor.",
        "defaults": {
          "dark": "charts.purple",
          "light": "charts.purple",
          "highContrast": "charts.purple",
          "highContrastLight": "charts.purple"
        }
      }
    ],
    "icons": {
      "dear-reviewer-logo": {
        "description": "The Dear Reviewer logo",
        "default": {
          "fontPath": "media/dear-reviewer-logo.woff",
          "fontCharacter": "\\E000"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dearReviewer",
          "title": "Dear Reviewer",
          "icon": "media/dear-reviewer.svg"
        }
      ]
    },
    "views": {
      "dearReviewer": [
        {
          "type": "webview",
          "id": "dearReviewer.dashboard",
          "name": "Dashboard",
          "when": "!dearReviewer.inReviewWindow"
        },
        {
          "id": "dearReviewer.changeFiles",
          "name": "Change Files",
          "when": "dearReviewer.inReviewWindow || dearReviewer.hasOpenChange"
        },
        {
          "id": "dearReviewer.findings",
          "name": "Findings",
          "when": "dearReviewer.inReviewWindow || dearReviewer.hasOpenChange"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dearReviewer.refreshInbox",
          "when": "view == dearReviewer.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "dearReviewer.addRepository",
          "when": "view == dearReviewer.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "dearReviewer.forgetRepository",
          "when": "view == dearReviewer.dashboard",
          "group": "repositories@1"
        },
        {
          "command": "dearReviewer.openSetup",
          "when": "view == dearReviewer.dashboard",
          "group": "setup@1"
        },
        {
          "command": "dearReviewer.showTimeline",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hasOpenChange",
          "group": "navigation@1"
        },
        {
          "command": "dearReviewer.refreshChangeFiles",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hasOpenChange",
          "group": "navigation@9"
        },
        {
          "command": "dearReviewer.hideViewedFiles",
          "when": "view == dearReviewer.changeFiles && !dearReviewer.hideViewedFiles && dearReviewer.hasOpenChange",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.showViewedFiles",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hideViewedFiles && dearReviewer.hasOpenChange",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.sortByReadingOrder",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hasReadingOrder && dearReviewer.changeFilesSortBy == tree",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.sortByTree",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hasReadingOrder && dearReviewer.changeFilesSortBy == readingOrder",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.findIssues",
          "when": "view == dearReviewer.findings && dearReviewer.hasOpenChange",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dearReviewer.openPullRequest",
          "when": "false"
        },
        {
          "command": "dearReviewer.openLocalBranch",
          "when": "false"
        },
        {
          "command": "dearReviewer.openChangeFile",
          "when": "false"
        },
        {
          "command": "dearReviewer.markViewed",
          "when": "false"
        },
        {
          "command": "dearReviewer.markViewedAndClose",
          "when": "false"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "false"
        },
        {
          "command": "dearReviewer.hideViewedFiles",
          "when": "!dearReviewer.hideViewedFiles"
        },
        {
          "command": "dearReviewer.showViewedFiles",
          "when": "dearReviewer.hideViewedFiles"
        },
        {
          "command": "dearReviewer.sortByReadingOrder",
          "when": "dearReviewer.changeFilesSortBy == tree"
        },
        {
          "command": "dearReviewer.sortByTree",
          "when": "dearReviewer.changeFilesSortBy == readingOrder"
        },
        {
          "command": "dearReviewer.suggestReadingOrder",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.addComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.startReview",
          "when": "false"
        },
        {
          "command": "dearReviewer.addToReview",
          "when": "false"
        },
        {
          "command": "dearReviewer.replyToThread",
          "when": "false"
        },
        {
          "command": "dearReviewer.resolveThread",
          "when": "false"
        },
        {
          "command": "dearReviewer.unresolveThread",
          "when": "false"
        },
        {
          "command": "dearReviewer.editComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.saveComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.cancelEditComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.deleteComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.sendSelectionToAssistant",
          "when": "editorIsOpen && (resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// || resourceScheme == dear-reviewer-commit)"
        },
        {
          "command": "dearReviewer.askAssistant",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.copyBrief",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/briefs\\//"
        },
        {
          "command": "dearReviewer.convertFinding",
          "when": "dearReviewer.hasFindings"
        },
        {
          "command": "dearReviewer.dismissFinding",
          "when": "dearReviewer.hasFindings"
        },
        {
          "command": "dearReviewer.revealFinding",
          "when": "false"
        },
        {
          "command": "dearReviewer.submitReview",
          "when": "dearReviewer.hasOpenChange && dearReviewer.frontIsPullRequest"
        },
        {
          "command": "dearReviewer.writeBrief",
          "when": "dearReviewer.hasOpenChange && !dearReviewer.frontIsPullRequest"
        },
        {
          "command": "dearReviewer.finishReview",
          "when": "false"
        },
        {
          "command": "dearReviewer.nextUnviewedFile",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.previousUnviewedFile",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.markViewedAndNext",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.nextFinding",
          "when": "dearReviewer.hasFindings"
        },
        {
          "command": "dearReviewer.previousFinding",
          "when": "dearReviewer.hasFindings"
        },
        {
          "command": "dearReviewer.openAllChanges",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.showDashboard",
          "when": "!dearReviewer.inReviewWindow"
        }
      ],
      "editor/title": [
        {
          "command": "dearReviewer.copyBrief",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/briefs\\//",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.askAssistant",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// || resourceScheme == dear-reviewer-commit",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.markViewedAndNext",
          "when": "resourceScheme == file && resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// && resourcePath not in dearReviewer.viewedFiles",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "resourceScheme == file && resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// && resourcePath in dearReviewer.viewedFiles",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.showTimeline",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// || resourceScheme == dear-reviewer-commit",
          "group": "1_dearReviewer@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "dearReviewer.markViewed",
          "when": "resourceScheme == file && resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// && resourcePath not in dearReviewer.viewedFiles",
          "group": "4_viewed@1"
        },
        {
          "command": "dearReviewer.markViewedAndClose",
          "when": "resourceScheme == file && resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// && resourcePath not in dearReviewer.viewedFiles",
          "group": "4_viewed@2"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "resourceScheme == file && resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// && resourcePath in dearReviewer.viewedFiles",
          "group": "4_viewed@3"
        }
      ],
      "editor/context": [
        {
          "command": "dearReviewer.sendSelectionToAssistant",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// || resourceScheme == dear-reviewer-commit",
          "group": "1_dearReviewer@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dearReviewer.markViewed",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^(file\\.unviewed|directory|change(\\..+)?)$/",
          "group": "4_viewed@1"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^(file\\.viewed|directory|change(\\..+)?)$/",
          "group": "4_viewed@2"
        },
        {
          "command": "dearReviewer.convertFinding",
          "when": "view == dearReviewer.findings && viewItem == finding",
          "group": "inline@1"
        },
        {
          "command": "dearReviewer.dismissFinding",
          "when": "view == dearReviewer.findings && viewItem == finding",
          "group": "inline@2"
        },
        {
          "command": "dearReviewer.convertFinding",
          "when": "view == dearReviewer.findings && viewItem == finding",
          "group": "finding@1"
        },
        {
          "command": "dearReviewer.dismissFinding",
          "when": "view == dearReviewer.findings && viewItem == finding",
          "group": "finding@2"
        },
        {
          "command": "dearReviewer.showTimeline",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "inline@1"
        },
        {
          "command": "dearReviewer.showAssistant",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "inline@3"
        },
        {
          "command": "dearReviewer.submitReview",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\.pullRequest/",
          "group": "1_finish@1"
        },
        {
          "command": "dearReviewer.writeBrief",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\.local/",
          "group": "1_finish@1"
        },
        {
          "command": "dearReviewer.discardReview",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "1_finish@2"
        },
        {
          "command": "dearReviewer.showChangesSinceLastReview",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\..*\\.since$/",
          "group": "2_review@1"
        },
        {
          "command": "dearReviewer.findIssues",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "2_review@2"
        },
        {
          "command": "dearReviewer.showTimeline",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "3_panels@1"
        },
        {
          "command": "dearReviewer.showAssistant",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "3_panels@2"
        },
        {
          "command": "dearReviewer.closeChange",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "9_close@1"
        },
        {
          "command": "dearReviewer.openAllChanges",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "2_review@0"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "dearReviewer.startReview",
          "group": "inline",
          "when": "commentController == dearReviewer.review && commentThreadIsEmpty && resourcePath not in dearReviewer.reviewInProgressFiles"
        },
        {
          "command": "dearReviewer.addToReview",
          "group": "inline",
          "when": "commentController == dearReviewer.review && commentThreadIsEmpty && resourcePath in dearReviewer.reviewInProgressFiles"
        },
        {
          "command": "dearReviewer.replyToThread",
          "group": "inline",
          "when": "commentController == dearReviewer.review && !commentThreadIsEmpty && commentThread != pending"
        },
        {
          "command": "dearReviewer.addToReview",
          "group": "inline",
          "when": "commentController == dearReviewer.review && !commentThreadIsEmpty && commentThread == pending"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "dearReviewer.resolveThread",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && commentThread == unresolved"
        },
        {
          "command": "dearReviewer.unresolveThread",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && commentThread == resolved"
        }
      ],
      "comments/comment/title": [
        {
          "command": "dearReviewer.editComment",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && comment == pending"
        },
        {
          "command": "dearReviewer.deleteComment",
          "group": "inline@2",
          "when": "commentController == dearReviewer.review && comment == pending"
        }
      ],
      "comments/comment/context": [
        {
          "command": "dearReviewer.cancelEditComment",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && comment =~ /^(pending|draft)$/"
        },
        {
          "command": "dearReviewer.saveComment",
          "group": "inline@2",
          "when": "commentController == dearReviewer.review && comment =~ /^(pending|draft)$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dearReviewer.nextUnviewedFile",
        "key": "ctrl+alt+r n",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.previousUnviewedFile",
        "key": "ctrl+alt+r p",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.markViewedAndNext",
        "key": "ctrl+alt+r v",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.nextFinding",
        "key": "ctrl+alt+r f",
        "when": "dearReviewer.hasFindings"
      },
      {
        "command": "dearReviewer.previousFinding",
        "key": "ctrl+alt+r shift+f",
        "when": "dearReviewer.hasFindings"
      },
      {
        "command": "dearReviewer.askAssistant",
        "key": "ctrl+alt+r a",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.findIssues",
        "key": "ctrl+alt+r i",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.finishReview",
        "key": "ctrl+alt+r s",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.showTimeline",
        "key": "ctrl+alt+r o",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.showDashboard",
        "key": "ctrl+alt+r h",
        "when": "!dearReviewer.inReviewWindow"
      },
      {
        "command": "dearReviewer.openAllChanges",
        "key": "ctrl+alt+r d",
        "when": "dearReviewer.hasOpenChange"
      }
    ],
    "viewsWelcome": [
      {
        "view": "dearReviewer.findings",
        "contents": "The Assistant raises Findings only when you ask: spots in a Change it thinks deserve your attention. Each one is marked in the gutter of the diff, where you dismiss it or turn it into a Comment. Nothing is published until you submit your Review.\n[Ask for Findings](command:dearReviewer.findIssues)",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "view": "dearReviewer.findings",
        "when": "!dearReviewer.hasOpenChange",
        "contents": "The Assistant raises Findings only when you ask: spots in a Change it thinks deserve your attention. Open a Change to ask for them."
      },
      {
        "view": "dearReviewer.changeFiles",
        "contents": "No Change is open in this window. Open a pull request or a local branch from the Dear Reviewer side bar in the window you work in, or [open a commit range](command:dearReviewer.openChange) as a Change."
      }
    ],
    "walkthroughs": [
      {
        "id": "setup",
        "title": "Set Up Dear Reviewer",
        "description": "From installing Dear Reviewer to submitting your first Review, without editing settings.",
        "steps": [
          {
            "id": "signIn",
            "title": "Sign in to GitHub",
            "description": "Dear Reviewer uses VS Code's GitHub sign-in to list your pull requests, comment and submit Reviews.\n[Sign In to GitHub](command:dearReviewer.signIn)\nWhere that sign-in isn't available, [use a personal access token](command:dearReviewer.setToken) instead; it is kept in the OS keychain.",
            "media": {
              "image": "media/dear-reviewer.svg",
              "altText": "The Dear Reviewer icon"
            },
            "completionEvents": [
              "onContext:dearReviewer.signedIn"
            ]
          },
          {
            "id": "repositories",
            "title": "Open your repositories",
            "description": "Every folder you have open that is a clone of a GitHub repository adds that repository to the Dashboard, with the folder as its clone, and Dear Reviewer remembers it. Add a clone you don't have open, or forget one, from the Dashboard's toolbar.\n[Add Repository](command:dearReviewer.addRepository)",
            "media": {
              "image": {
                "dark": "media/walkthrough/dashboard-dark.png",
                "light": "media/walkthrough/dashboard-light.png",
                "hc": "media/walkthrough/dashboard-dark.png",
                "hcLight": "media/walkthrough/dashboard-light.png"
              },
              "altText": "The Dashboard in the side bar: a pull request in progress, and pull requests waiting on you, each with its size and checks"
            },
            "completionEvents": [
              "onContext:dearReviewer.hasRepositories"
            ]
          },
          {
            "id": "claude",
            "title": "Check the Assistant's Claude login",
            "description": "The Assistant runs the claude CLI you already have, with its own login: install Claude Code and sign in by running claude in a terminal. Point the Claude Path setting at it if it isn't on the PATH.\n[Check Claude Login](command:dearReviewer.checkClaudeLogin)",
            "media": {
              "image": {
                "dark": "media/walkthrough/overview-dark.png",
                "light": "media/walkthrough/overview-light.png",
                "hc": "media/walkthrough/overview-dark.png",
                "hcLight": "media/walkthrough/overview-light.png"
              },
              "altText": "A Change's overview, with the Assistant's three-sentence take and where to start reading"
            },
            "completionEvents": [
              "onContext:dearReviewer.claudeSignedIn"
            ]
          },
          {
            "id": "trust",
            "title": "Trust the review window",
            "description": "Changes open in the review window, which the editor doesn't trust yet. Until you trust it, it is in Restricted Mode: no language servers and no code navigation. Trusting it turns them on for every Change you open, and also lets the reviewed code's workspace settings and tasks apply there, including for pull requests from people you don't know. The editor asks once, when the review window first opens, and you can choose here later. The button shows Workspace Trust in the review window; choose Trust there.\n[Trust the Review Window…](command:dearReviewer.trustReviewWindow)",
            "media": {
              "image": "media/dear-reviewer.svg",
              "altText": "The Dear Reviewer icon"
            },
            "completionEvents": [
              "onContext:dearReviewer.reviewWindowTrusted"
            ]
          },
          {
            "id": "open",
            "title": "Open a Change from the Dashboard",
            "description": "Click a pull request in the Dashboard. It opens as a Change in the review window, with its overview alone: what the Change is, where you stand on it, and the Assistant's short take, with where to start reading.\n[Show the Dashboard](command:dearReviewer.showDashboard)",
            "media": {
              "image": {
                "dark": "media/walkthrough/dashboard-dark.png",
                "light": "media/walkthrough/dashboard-light.png",
                "hc": "media/walkthrough/dashboard-dark.png",
                "hcLight": "media/walkthrough/dashboard-light.png"
              },
              "altText": "The Dashboard, with a pull request in progress as its filled button"
            },
            "completionEvents": [
              "onCommand:dearReviewer.openPullRequest",
              "onCommand:dearReviewer.openChange"
            ]
          },
          {
            "id": "read",
            "title": "Read the diff and comment",
            "description": "Start where the take says, then step through the files with Next unviewed file (Ctrl+Alt+R N, or ⌃⌥R N on a Mac). Comment in the gutter of the diff. Go to definition and find usages work on both sides of the diff once you trust the review window.",
            "media": {
              "image": {
                "dark": "media/walkthrough/overview-dark.png",
                "light": "media/walkthrough/overview-light.png",
                "hc": "media/walkthrough/overview-dark.png",
                "hcLight": "media/walkthrough/overview-light.png"
              },
              "altText": "A Change's overview, with its Reading Order and the Start at button"
            },
            "completionEvents": [
              "onCommand:dearReviewer.nextUnviewedFile"
            ]
          },
          {
            "id": "finish",
            "title": "Finish your Review",
            "description": "When every file is viewed, the overview offers Submit Review…: your verdict, a summary, and every Comment that publishes with it. A local Change ends with Write Brief… instead, and a Brief you copy for your agent. Ctrl+Alt+R S does either.\nEvery key is in Keyboard Shortcuts, where you can rebind it.\n[Show the Review Keys](command:dearReviewer.showReviewKeys)",
            "media": {
              "image": {
                "dark": "media/walkthrough/submit-dark.png",
                "light": "media/walkthrough/submit-light.png",
                "hc": "media/walkthrough/submit-dark.png",
                "hcLight": "media/walkthrough/submit-light.png"
              },
              "altText": "The Submit step in a Change's overview: a verdict, a summary and the Comments that publish"
            },
            "completionEvents": [
              "onCommand:dearReviewer.submitReview",
              "onCommand:dearReviewer.writeBrief"
            ]
          }
        ]
      }
    ]
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "~1.134.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "fantasticon": "^4.1.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "markdown-it": "^15.0.2",
    "sanitize-html": "^2.18.0"
  }
}
