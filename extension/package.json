          "command": "dearReviewer.openAllChanges",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.showDashboard",
          "when": "!dearReviewer.inReviewWindow"
        },
        {
          "command": "dearReviewer.showAssistant",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.showTimeline",
          "when": "dearReviewer.hasOpenChange"
        },
        {
          "command": "dearReviewer.findIssues",
          "when": "dearReviewer.hasOpenChange"
        },
