      "editor/title": [
        {
          "command": "dearReviewer.copyBrief",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/briefs\\//",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.askAssistant",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// || resourceScheme == dear-reviewer-commit",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.markViewedAndNext",
          "when": "resourceScheme == file && resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// && resourcePath not in dearReviewer.viewedFiles",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "resourceScheme == file && resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// && resourcePath in dearReviewer.viewedFiles",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.showTimeline",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// || resourceScheme == dear-reviewer-commit",
          "group": "1_dearReviewer@1"
        },
        {
          "command": "dearReviewer.showCodeFlow",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// || resourceScheme == dear-reviewer-commit",
          "group": "1_dearReviewer@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "dearReviewer.markViewed",
          "when": "resourceScheme == file && resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// && resourcePath not in dearReviewer.viewedFiles",
          "group": "4_viewed@1"
        },
        {
          "command": "dearReviewer.markViewedAndClose",
          "when": "resourceScheme == file && resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// && resourcePath not in dearReviewer.viewedFiles",
          "group": "4_viewed@2"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "resourceScheme == file && resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// && resourcePath in dearReviewer.viewedFiles",
          "group": "4_viewed@3"
        }
      ],
      "editor/context": [
        {
          "command": "dearReviewer.sendSelectionToAssistant",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\// || resourceScheme == dear-reviewer-commit",
          "group": "1_dearReviewer@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dearReviewer.markViewed",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^(file\\.unviewed|directory|change(\\..+)?)$/",
          "group": "4_viewed@1"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^(file\\.viewed|directory|change(\\..+)?)$/",
          "group": "4_viewed@2"
        },
        {
          "command": "dearReviewer.convertFinding",
          "when": "view == dearReviewer.findings && viewItem == finding",
          "group": "inline@1"
        },
        {
          "command": "dearReviewer.dismissFinding",
          "when": "view == dearReviewer.findings && viewItem == finding",
          "group": "inline@2"
        },
        {
          "command": "dearReviewer.convertFinding",
          "when": "view == dearReviewer.findings && viewItem == finding",
          "group": "finding@1"
        },
        {
          "command": "dearReviewer.dismissFinding",
          "when": "view == dearReviewer.findings && viewItem == finding",
          "group": "finding@2"
        },
        {
          "command": "dearReviewer.showTimeline",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "inline@1"
        },
        {
          "command": "dearReviewer.showChangesSinceLastReview",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\..*\\.since$/",
          "group": "inline@2"
        },
        {
          "command": "dearReviewer.showAssistant",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "inline@3"
        },
        {
          "command": "dearReviewer.submitReview",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\.pullRequest/",
          "group": "1_finish@1"
        },
        {
          "command": "dearReviewer.writeBrief",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\.local/",
          "group": "1_finish@1"
        },
        {
          "command": "dearReviewer.discardReview",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "1_finish@2"
        },
        {
          "command": "dearReviewer.showChangesSinceLastReview",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\..*\\.since$/",
          "group": "2_review@1"
        },
        {
          "command": "dearReviewer.findIssues",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "2_review@2"
        },
        {
          "command": "dearReviewer.showTimeline",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "3_panels@1"
        },
        {
          "command": "dearReviewer.showAssistant",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "3_panels@2"
        },
        {
          "command": "dearReviewer.showCodeFlow",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "3_panels@3"
        },
        {
          "command": "dearReviewer.viewOnGitHub",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\.pullRequest/",
          "group": "8_github@1"
        },
        {
          "command": "dearReviewer.closeChange",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "9_close@1"
        },
        {
          "command": "dearReviewer.openAllChanges",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^change\\./",
          "group": "2_review@0"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "dearReviewer.startReview",
          "group": "inline",
          "when": "commentController == dearReviewer.review && commentThreadIsEmpty && resourcePath not in dearReviewer.reviewInProgressFiles"
        },
        {
          "command": "dearReviewer.addToReview",
          "group": "inline",
          "when": "commentController == dearReviewer.review && commentThreadIsEmpty && resourcePath in dearReviewer.reviewInProgressFiles"
        },
        {
          "command": "dearReviewer.replyToThread",
          "group": "inline",
          "when": "commentController == dearReviewer.review && !commentThreadIsEmpty && commentThread != pending"
        },
        {
          "command": "dearReviewer.addToReview",
          "group": "inline",
          "when": "commentController == dearReviewer.review && !commentThreadIsEmpty && commentThread == pending"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "dearReviewer.resolveThread",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && commentThread == unresolved"
        },
        {
          "command": "dearReviewer.unresolveThread",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && commentThread == resolved"
        }
      ],
      "comments/comment/title": [
        {
          "command": "dearReviewer.addAgentNote",
          "group": "inline@0",
          "when": "commentController == dearReviewer.review && comment == pending"
        },
        {
          "command": "dearReviewer.editComment",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && comment =~ /^pending/"
        },
        {
          "command": "dearReviewer.deleteComment",
          "group": "inline@2",
          "when": "commentController == dearReviewer.review && comment =~ /^pending/"
        }
      ],
      "comments/comment/context": [
        {
          "command": "dearReviewer.cancelEditComment",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && comment =~ /^(pending|draft)/"
        },
        {
          "command": "dearReviewer.saveComment",
          "group": "inline@2",
          "when": "commentController == dearReviewer.review && comment =~ /^(pending|draft)/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dearReviewer.nextUnviewedFile",
        "key": "ctrl+alt+r n",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.previousUnviewedFile",
        "key": "ctrl+alt+r p",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.markViewedAndNext",
        "key": "ctrl+alt+r v",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.showCodeFlow",
        "key": "ctrl+alt+r g",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.nextFinding",
        "key": "ctrl+alt+r f",
        "when": "dearReviewer.hasFindings"
      },
      {
        "command": "dearReviewer.previousFinding",
        "key": "ctrl+alt+r shift+f",
        "when": "dearReviewer.hasFindings"
      },
      {
        "command": "dearReviewer.askAssistant",
        "key": "ctrl+alt+r a",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.findIssues",
        "key": "ctrl+alt+r i",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.finishReview",
        "key": "ctrl+alt+r s",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.showTimeline",
        "key": "ctrl+alt+r o",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.showDashboard",
        "key": "ctrl+alt+r h",
        "when": "!dearReviewer.inReviewWindow"
      },
      {
        "command": "dearReviewer.openAllChanges",
        "key": "ctrl+alt+r d",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "command": "dearReviewer.showChangesSinceLastReview",
        "key": "ctrl+alt+r c",
        "when": "dearReviewer.hasOpenChange"
      }
    ],
    "viewsWelcome": [
      {
        "view": "dearReviewer.findings",
        "contents": "The Assistant looks for spots worth a second look, only when you ask. Each shows in the diff's gutter, where you can dismiss it or turn it into a Comment. Ctrl+Alt+R F, or ⌃⌥R F on a Mac, steps through them.\n[Ask for Findings](command:dearReviewer.findIssues)",
        "when": "dearReviewer.hasOpenChange"
      },
      {
        "view": "dearReviewer.findings",
        "when": "!dearReviewer.hasOpenChange",
        "contents": "The Assistant looks for spots worth a second look, only when you ask. Open a Change to ask for them."
      },
      {
        "view": "dearReviewer.changeFiles",
        "contents": "No Change is open in this window. Open a pull request or a local branch from the Dear Reviewer side bar in the window you work in, or [open a commit range](command:dearReviewer.openChange) as a Change."
      }
    ],
    "walkthroughs": [
      {
        "id": "setup",
        "title": "Set Up Dear Reviewer",
        "description": "From installing Dear Reviewer to submitting your first Review, without editing settings.",
        "steps": [
          {
            "id": "signIn",
            "title": "Sign in to GitHub",
            "description": "Dear Reviewer uses VS Code's GitHub sign-in to list your pull requests, comment and submit Reviews.\n[Sign In to GitHub](command:dearReviewer.signIn)\nWhere that sign-in isn't available, [use a personal access token](command:dearReviewer.setToken) instead; it is kept in the OS keychain.",
            "media": {
              "image": {
                "dark": "media/walkthrough/signin-dark.png",
                "light": "media/walkthrough/signin-light.png",
                "hc": "media/walkthrough/signin-dark.png",
                "hcLight": "media/walkthrough/signin-light.png"
              },
              "altText": "The Dashboard before sign-in, with Sign In to GitHub as its one filled button"
            },
            "completionEvents": [
              "onContext:dearReviewer.signedIn"
            ]
          },
          {
            "id": "repositories",
            "title": "Open your repositories",
            "description": "Every folder you have open that is a clone of a GitHub repository adds that repository to the Dashboard, with the folder as its clone, and Dear Reviewer remembers it. Add a clone you don't have open, or forget one, from the Dashboard's toolbar.\n[Add Repository](command:dearReviewer.addRepository)",
            "media": {
              "image": {
                "dark": "media/walkthrough/repos-dark.png",
                "light": "media/walkthrough/repos-light.png",
                "hc": "media/walkthrough/repos-dark.png",
                "hcLight": "media/walkthrough/repos-light.png"
              },
              "altText": "The Dashboard with no repository yet, offering Add Repository…, Open Folder… and the Repositories setting"
            },
            "completionEvents": [
              "onContext:dearReviewer.hasRepositories"
            ]
          },
          {
            "id": "claude",
            "title": "Check the Assistant's Claude login",
            "description": "The Assistant runs the claude CLI you already have, with its own login: install Claude Code and sign in by running claude in a terminal. Point the Claude Command setting at it if it isn't on the PATH.\n[Check Claude Login](command:dearReviewer.checkClaudeLogin)",
            "media": {
              "image": {
                "dark": "media/walkthrough/claude-dark.png",
                "light": "media/walkthrough/claude-light.png",
                "hc": "media/walkthrough/claude-dark.png",
                "hcLight": "media/walkthrough/claude-light.png"
              },
              "altText": "The Assistant's panel, showing the Claude login in its header and the Assistant's reply beside its rule"
            },
            "completionEvents": [
              "onContext:dearReviewer.claudeSignedIn"
            ]
          },
          {
            "id": "trust",
            "title": "Trust the review window",
            "description": "The review window is in Restricted Mode until you trust it: no language servers and no code navigation. Trusting it turns them on for every Change, and lets the reviewed code's workspace settings and tasks run there, even for pull requests from people you don't know. The editor asks once; you can choose here later.\n[Trust the Review Window…](command:dearReviewer.trustReviewWindow)",
            "media": {
              "image": {
                "dark": "media/walkthrough/trust-dark.png",
                "light": "media/walkthrough/trust-light.png",
                "hc": "media/walkthrough/trust-dark.png",
                "hcLight": "media/walkthrough/trust-light.png"
              },
              "altText": "A Change's overview in a review window that isn't trusted yet, with a Trust the review window… link in its standing line"
            },
            "completionEvents": [
              "onContext:dearReviewer.reviewWindowTrusted"
            ]
          },
          {
            "id": "open",
            "title": "Open a Change from the Dashboard",
            "description": "Click a pull request in the Dashboard, or choose Open Pull Request or Branch… in the palette. It opens as a Change in the review window, with its overview alone: what the Change is, where you stand on it, and the Assistant's short take, with where to start reading.\n[Show the Dashboard](command:dearReviewer.showDashboard)",
            "media": {
              "image": {
                "dark": "media/walkthrough/open-dark.png",
                "light": "media/walkthrough/open-light.png",
                "hc": "media/walkthrough/open-dark.png",
                "hcLight": "media/walkthrough/open-light.png"
              },
              "altText": "The Dashboard with two pull requests waiting, and Review acme/infra #1203 as its filled button"
            },
            "completionEvents": [
              "onCommand:dearReviewer.openPullRequest",
              "onCommand:dearReviewer.openLocalBranch",
              "onCommand:dearReviewer.openChange"
            ]
          },
          {
            "id": "read",
            "title": "Read the diff and comment",
            "description": "Start where the take says, then step through the files with Next unviewed file (Ctrl+Alt+R N, or ⌃⌥R N on a Mac). Comment in the gutter of the diff. Go to definition and find usages work on both sides of the diff once you trust the review window. Code Flow (Ctrl+Alt+R G), beside Ask the Assistant, maps which of the changed functions call which, and can have the Assistant take you through those calls in order.",
            "media": {
              "image": {
                "dark": "media/walkthrough/read-dark.png",
                "light": "media/walkthrough/read-light.png",
                "hc": "media/walkthrough/read-dark.png",
                "hcLight": "media/walkthrough/read-light.png"
              },
              "altText": "A Change's overview, with Start at, Next unviewed file, Ask the Assistant and Code Flow, each but Start at showing its key"
            },
            "completionEvents": [
              "onCommand:dearReviewer.nextUnviewedFile",
              "onCommand:dearReviewer.markViewed"
            ]
          },
          {
            "id": "finish",
            "title": "Finish your Review",
            "description": "When every file is viewed, the overview offers Submit Review…: your verdict, a summary, and every Comment that publishes with it. A local Change ends with Write Brief… instead, and a Brief you copy for your agent. Ctrl+Alt+R S does either.\nEvery key is in Keyboard Shortcuts, where you can rebind it; the hints beside the overview's buttons show the defaults.\n[Show the Review Keys](command:dearReviewer.showReviewKeys)\nFor a hard Change, Dear Reviewer's review tools help: Findings, Code Flow and what changed since your Review.\n[Show Review Tools](command:dearReviewer.openReviewTools)",
            "media": {
              "image": {
                "dark": "media/walkthrough/finish-dark.png",
                "light": "media/walkthrough/finish-light.png",
                "hc": "media/walkthrough/finish-dark.png",
                "hcLight": "media/walkthrough/finish-light.png"
              },
              "altText": "The Submit step in a Change's overview: a verdict, a summary and the Comments that publish"
            },
            "completionEvents": [
              "onCommand:dearReviewer.submitReview",
              "onCommand:dearReviewer.writeBrief"
            ]
          }
        ]
      },
      {
        "id": "review",
        "title": "Dear Reviewer's Review Tools",
        "description": "The tools for a hard Change: Findings, Code Flow, what changed since your Review, skim-only files and the review keys.",
        "steps": [
          {
            "id": "findings",
            "title": "Ask for Findings",
            "description": "The Assistant points at spots that deserve your attention only when you ask: bugs, missed edge cases, security problems or code that misleads. Each Finding shows in the gutter of the diff and in the Findings view. Turn one into a Comment, or dismiss it: a Finding is never published. Ctrl+Alt+R F steps through them, and Ctrl+Alt+R Shift+F goes back.\n[Ask for Findings](command:dearReviewer.findIssues)",
            "media": {
              "markdown": "media/walkthrough/findings.md"
            },
            "completionEvents": [
              "onCommand:dearReviewer.findIssues"
            ]
          },
          {
            "id": "codeFlow",
            "title": "Follow the calls with Code Flow",
            "description": "Code Flow maps which of the changed functions call which, from the language servers you have. Open it from the Code Flow button in the overview, or with Ctrl+Alt+R G. In its Walkthrough view, the Assistant takes you through those calls in the order they run.\n[Show Code Flow](command:dearReviewer.showCodeFlow)",
            "media": {
              "image": {
                "dark": "media/walkthrough/codeflow-dark.png",
                "light": "media/walkthrough/codeflow-light.png",
                "hc": "media/walkthrough/codeflow-dark.png",
                "hcLight": "media/walkthrough/codeflow-light.png"
              },
              "altText": "Code Flow's call map of a Change, with the changed functions and the functions they call"
            },
            "completionEvents": [
              "onCommand:dearReviewer.showCodeFlow"
            ]
          },
          {
            "id": "since",
            "title": "See what changed since your Review",
            "description": "When new commits arrive after your Review, the overview says so, and the Assistant explains them. Click New commits since your Review, or press Ctrl+Alt+R C, for a diff of only those commits.\n[Show Changes Since Your Last Review](command:dearReviewer.showChangesSinceLastReview)",
            "media": {
              "image": {
                "dark": "media/walkthrough/since-dark.png",
                "light": "media/walkthrough/since-light.png",
                "hc": "media/walkthrough/since-dark.png",
                "hcLight": "media/walkthrough/since-light.png"
              },
              "altText": "A Change's overview with New commits since your Review as a link, and the Assistant's explanation of the new commits"
            },
            "completionEvents": [
              "onCommand:dearReviewer.showChangesSinceLastReview"
            ]
          },
          {
            "id": "skim",
            "title": "Skim lock files and generated code",
            "description": "Lock files, generated files, renames with no edits and files that were only reformatted are skim-only: the Reading Order puts them last, and Next unviewed file skips them until nothing else is left to view. Turn on Visit Skim Only Files to step through them with the rest.\n[Open the Setting](command:workbench.action.openSettings?%5B%22dearReviewer.visitSkimOnlyFiles%22%5D)",
            "media": {
              "image": {
                "dark": "media/walkthrough/skim-dark.png",
                "light": "media/walkthrough/skim-light.png",
                "hc": "media/walkthrough/skim-dark.png",
                "hcLight": "media/walkthrough/skim-light.png"
              },
              "altText": "A Change's Reading Order, with lock files and generated files in its last step, Skim-only"
            },
            "completionEvents": [
              "onSettingChanged:dearReviewer.visitSkimOnlyFiles"
            ]
          },
          {
            "id": "keys",
            "title": "Learn the review keys",
            "description": "Every review key starts with Ctrl+Alt+R, or ⌃⌥R on a Mac. You can change any of them in Keyboard Shortcuts.\n[Show the Review Keys](command:dearReviewer.showReviewKeys)",
            "media": {
              "markdown": "media/walkthrough/keys.md"
            },
            "completionEvents": [
              "onCommand:dearReviewer.showReviewKeys"
            ]
          }
        ]
      }
    ]
  },
