{
  "name": "dear-reviewer",
  "displayName": "Dear Reviewer",
  "description": "A workbench for reviewing Changes, with real code navigation on both sides of the diff.",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "publisher": "edziegle",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The GitHub API base URL, the local clones and the path to claude are only read from user settings.",
      "restrictedConfigurations": [
        "dearReviewer.githubApiUrl",
        "dearReviewer.claudePath",
        "dearReviewer.localClones"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "dearReviewer.openChange",
        "title": "Open Change",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.openPullRequest",
        "title": "Open Pull Request",
        "category": "Dear Reviewer",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "dearReviewer.openLocalBranch",
        "title": "Open Branch",
        "category": "Dear Reviewer",
        "icon": "$(git-branch)"
      },
      {
        "command": "dearReviewer.closeChange",
        "title": "Close Change",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.signIn",
        "title": "Sign In to GitHub",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.refreshInbox",
        "title": "Refresh Inbox",
        "category": "Dear Reviewer",
        "icon": "$(refresh)"
      },
      {
        "command": "dearReviewer.setToken",
        "title": "Use a GitHub Personal Access Token\u2026",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.forgetToken",
        "title": "Forget GitHub Personal Access Token",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.openChangeFile",
        "title": "Open Diff",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.markViewed",
        "title": "Mark Viewed",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.unmarkViewed",
        "title": "Unmark Viewed",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.hideViewedFiles",
        "title": "Hide Viewed Files",
        "category": "Dear Reviewer",
        "icon": "$(eye-closed)"
      },
      {
        "command": "dearReviewer.showViewedFiles",
        "title": "Show Viewed Files",
        "category": "Dear Reviewer",
        "icon": "$(eye)"
      },
      {
        "command": "dearReviewer.showAssistant",
        "title": "Show Assistant",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.showTimeline",
        "title": "Show Timeline",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.checkClaudeLogin",
        "title": "Check Claude Login",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.addComment",
        "title": "Add Comment",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.editComment",
        "title": "Edit Comment",
        "category": "Dear Reviewer",
        "icon": "$(edit)"
      },
      {
        "command": "dearReviewer.saveComment",
        "title": "Save",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.cancelEditComment",
        "title": "Cancel",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.deleteComment",
        "title": "Delete Comment",
        "category": "Dear Reviewer",
        "icon": "$(trash)"
      },
      {
        "command": "dearReviewer.submitReview",
        "title": "Submit Review",
        "category": "Dear Reviewer"
      }
    ],
    "configuration": {
      "title": "Dear Reviewer",
      "properties": {
        "dearReviewer.repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^/\\s]+/[^/\\s]+$"
          },
          "default": [],
          "markdownDescription": "The GitHub repositories, as `owner/name`, whose pull requests feed the Inbox."
        },
        "dearReviewer.localClones": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Where each Inbox repository is cloned on this machine, as `\"owner/name\": \"/path/to/clone\"`. Opening a pull request fetches its head into this clone, from the remote whose URL names the repository (or `origin`), and reviews it in worktrees of the clone. The Inbox also lists the clone's local branches that are ahead of its main branch.",
          "scope": "machine"
        },
        "dearReviewer.githubApiUrl": {
          "type": "string",
          "default": "https://api.github.com",
          "markdownDescription": "The GitHub API base URL. For GitHub Enterprise Server, use `https://<host>/api/v3`.",
          "scope": "application"
        },
        "dearReviewer.claudePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `claude` executable the Assistant runs, such as `/opt/homebrew/bin/claude`. Leave empty to use the `claude` on the PATH or in a usual install location. The Assistant uses whichever Claude login this `claude` has; sign in by running `claude` in a terminal.",
          "scope": "machine"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dearReviewer",
          "title": "Dear Reviewer",
          "icon": "media/dear-reviewer.svg"
        }
      ]
    },
    "views": {
      "dearReviewer": [
        {
          "id": "dearReviewer.inbox",
          "name": "Inbox"
        },
        {
          "id": "dearReviewer.changeFiles",
          "name": "Change Files"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dearReviewer.refreshInbox",
          "when": "view == dearReviewer.inbox",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.hideViewedFiles",
          "when": "view == dearReviewer.changeFiles && !dearReviewer.hideViewedFiles",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.showViewedFiles",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hideViewedFiles",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dearReviewer.openPullRequest",
          "when": "false"
        },
        {
          "command": "dearReviewer.openLocalBranch",
          "when": "false"
        },
        {
          "command": "dearReviewer.openChangeFile",
          "when": "false"
        },
        {
          "command": "dearReviewer.markViewed",
          "when": "false"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "false"
        },
        {
          "command": "dearReviewer.hideViewedFiles",
          "when": "!dearReviewer.hideViewedFiles"
        },
        {
          "command": "dearReviewer.showViewedFiles",
          "when": "dearReviewer.hideViewedFiles"
        },
        {
          "command": "dearReviewer.addComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.editComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.saveComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.cancelEditComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.deleteComment",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "dearReviewer.openPullRequest",
          "when": "view == dearReviewer.inbox && viewItem == pullRequest",
          "group": "inline"
        },
        {
          "command": "dearReviewer.openPullRequest",
          "when": "view == dearReviewer.inbox && viewItem == pullRequest",
          "group": "open@1"
        },
        {
          "command": "dearReviewer.openLocalBranch",
          "when": "view == dearReviewer.inbox && viewItem == localBranch",
          "group": "inline"
        },
        {
          "command": "dearReviewer.openLocalBranch",
          "when": "view == dearReviewer.inbox && viewItem == localBranch",
          "group": "open@1"
        },
        {
          "command": "dearReviewer.markViewed",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^(file\\.unviewed|directory|change)$/",
          "group": "viewed@1"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^(file\\.viewed|directory|change)$/",
          "group": "viewed@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "dearReviewer.addComment",
          "group": "inline",
          "when": "commentController == dearReviewer.review && commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "dearReviewer.editComment",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && comment == pending"
        },
        {
          "command": "dearReviewer.deleteComment",
          "group": "inline@2",
          "when": "commentController == dearReviewer.review && comment == pending"
        }
      ],
      "comments/comment/context": [
        {
          "command": "dearReviewer.cancelEditComment",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && comment == pending"
        },
        {
          "command": "dearReviewer.saveComment",
          "group": "inline@2",
          "when": "commentController == dearReviewer.review && comment == pending"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dearReviewer.inbox",
        "when": "dearReviewer.inboxWelcome == signedOut",
        "contents": "Sign in to GitHub to see the pull requests awaiting your review and the ones you authored.\n[Sign In to GitHub](command:dearReviewer.signIn)\nIf VS Code's GitHub sign-in isn't available, use a personal access token instead.\n[Use a Personal Access Token](command:dearReviewer.setToken)"
      },
      {
        "view": "dearReviewer.inbox",
        "when": "dearReviewer.inboxWelcome == noRepositories",
        "contents": "List the repositories that feed the Inbox, as owner/name, in the Dear Reviewer: Repositories setting.\n[Open Settings](command:workbench.action.openSettings?%22dearReviewer.repositories%22)"
      },
      {
        "view": "dearReviewer.changeFiles",
        "contents": "No Change is open in this window.\n[Open Change](command:dearReviewer.openChange)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  }
}
