    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "markdown-it": "^15.0.2",
    "sanitize-html": "^2.18.0"
  }
}
