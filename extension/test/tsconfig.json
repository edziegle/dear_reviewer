{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "strict": true,
    "esModuleInterop": true,
    "types": ["node", "vscode", "mocha"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": ".",
