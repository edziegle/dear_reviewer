{
  "name": "dear-reviewer",
  "displayName": "Dear Reviewer",
  "description": "A workbench for reviewing Changes, with real code navigation on both sides of the diff.",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "publisher": "edziegle",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The GitHub API base URL, the local clones and the path to claude are only read from user settings, and the repositories of a window's folders are only read once the window is trusted.",
      "restrictedConfigurations": [
        "dearReviewer.githubApiUrl",
        "dearReviewer.claudePath",
        "dearReviewer.localClones"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "dearReviewer.openChange",
        "title": "Open Change",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.openPullRequest",
        "title": "Open Pull Request",
        "category": "Dear Reviewer",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "dearReviewer.openLocalBranch",
        "title": "Open Branch",
        "category": "Dear Reviewer",
        "icon": "$(git-branch)"
      },
      {
        "command": "dearReviewer.closeChange",
        "title": "Close Change",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.signIn",
        "title": "Sign In to GitHub",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.refreshInbox",
        "title": "Refresh Inbox",
        "category": "Dear Reviewer",
        "icon": "$(refresh)"
      },
      {
        "command": "dearReviewer.addRepository",
        "title": "Add Repository…",
        "category": "Dear Reviewer",
        "icon": "$(add)"
      },
      {
        "command": "dearReviewer.locateClone",
        "title": "Locate Clone…",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.forgetRepository",
        "title": "Forget Repository…",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.openSetup",
        "title": "Set Up Dear Reviewer",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.setToken",
        "title": "Use a GitHub Personal Access Token…",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.forgetToken",
        "title": "Forget GitHub Personal Access Token",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.openChangeFile",
        "title": "Open Diff",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.markViewed",
        "title": "Mark Viewed",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.unmarkViewed",
        "title": "Unmark Viewed",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.refreshChangeFiles",
        "title": "Refresh Change Files",
        "category": "Dear Reviewer",
        "icon": "$(refresh)"
      },
      {
        "command": "dearReviewer.hideViewedFiles",
        "title": "Hide Viewed Files",
        "category": "Dear Reviewer",
        "icon": "$(eye-closed)"
      },
      {
        "command": "dearReviewer.showViewedFiles",
        "title": "Show Viewed Files",
        "category": "Dear Reviewer",
        "icon": "$(eye)"
      },
      {
        "command": "dearReviewer.showAssistant",
        "title": "Show Assistant",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.showTimeline",
        "title": "Show Timeline",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.sendSelectionToAssistant",
        "title": "Send Selection to Assistant",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.checkClaudeLogin",
        "title": "Check Claude Login",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.addComment",
        "title": "Add Comment",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.editComment",
        "title": "Edit Comment",
        "category": "Dear Reviewer",
        "icon": "$(edit)"
      },
      {
        "command": "dearReviewer.saveComment",
        "title": "Save",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.cancelEditComment",
        "title": "Cancel",
        "category": "Dear Reviewer"
      },
      {
        "command": "dearReviewer.deleteComment",
        "title": "Delete Comment",
        "category": "Dear Reviewer",
        "icon": "$(trash)"
      },
      {
        "command": "dearReviewer.submitReview",
        "title": "Submit Review",
        "category": "Dear Reviewer"
      }
    ],
    "configuration": {
      "title": "Dear Reviewer",
      "properties": {
        "dearReviewer.repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "default": [],
          "markdownDescription": "More GitHub repositories, as `owner/name`, whose pull requests feed the Inbox. You rarely need this: every folder open in VSCodium that is a clone of a GitHub repository adds that repository by itself, and Dear Reviewer remembers it for the review window."
        },
        "dearReviewer.localClones": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Where a repository is cloned on this machine, as `\"owner/name\": \"/path/to/clone\"`, when it isn't a folder you open in VSCodium. Takes precedence over clones Dear Reviewer found or remembered. Opening a pull request fetches its head into the clone, from the remote whose URL names the repository (or `origin`), and reviews it in worktrees of the clone. The Inbox also lists the clone's local branches that are ahead of its main branch.",
          "scope": "machine"
        },
        "dearReviewer.githubApiUrl": {
          "type": "string",
          "default": "https://api.github.com",
          "markdownDescription": "The GitHub API base URL. For GitHub Enterprise Server, use `https://<host>/api/v3`.",
          "scope": "application"
        },
        "dearReviewer.claudePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `claude` executable the Assistant runs, such as `/opt/homebrew/bin/claude`. Leave empty to use the `claude` on the PATH or in a usual install location. The Assistant uses whichever Claude login this `claude` has; sign in by running `claude` in a terminal.",
          "scope": "machine"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dearReviewer",
          "title": "Dear Reviewer",
          "icon": "media/dear-reviewer.svg"
        }
      ]
    },
    "views": {
      "dearReviewer": [
        {
          "id": "dearReviewer.inbox",
          "name": "Inbox"
        },
        {
          "id": "dearReviewer.changeFiles",
          "name": "Change Files"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dearReviewer.refreshInbox",
          "when": "view == dearReviewer.inbox",
          "group": "navigation@2"
        },
        {
          "command": "dearReviewer.addRepository",
          "when": "view == dearReviewer.inbox",
          "group": "navigation@1"
        },
        {
          "command": "dearReviewer.forgetRepository",
          "when": "view == dearReviewer.inbox",
          "group": "repositories@1"
        },
        {
          "command": "dearReviewer.openSetup",
          "when": "view == dearReviewer.inbox",
          "group": "setup@1"
        },
        {
          "command": "dearReviewer.refreshChangeFiles",
          "when": "view == dearReviewer.changeFiles",
          "group": "navigation@9"
        },
        {
          "command": "dearReviewer.hideViewedFiles",
          "when": "view == dearReviewer.changeFiles && !dearReviewer.hideViewedFiles",
          "group": "navigation"
        },
        {
          "command": "dearReviewer.showViewedFiles",
          "when": "view == dearReviewer.changeFiles && dearReviewer.hideViewedFiles",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dearReviewer.openPullRequest",
          "when": "false"
        },
        {
          "command": "dearReviewer.openLocalBranch",
          "when": "false"
        },
        {
          "command": "dearReviewer.openChangeFile",
          "when": "false"
        },
        {
          "command": "dearReviewer.markViewed",
          "when": "false"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "false"
        },
        {
          "command": "dearReviewer.hideViewedFiles",
          "when": "!dearReviewer.hideViewedFiles"
        },
        {
          "command": "dearReviewer.showViewedFiles",
          "when": "dearReviewer.hideViewedFiles"
        },
        {
          "command": "dearReviewer.addComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.editComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.saveComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.cancelEditComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.deleteComment",
          "when": "false"
        },
        {
          "command": "dearReviewer.sendSelectionToAssistant",
          "when": "editorIsOpen && resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\//"
        }
      ],
      "editor/context": [
        {
          "command": "dearReviewer.sendSelectionToAssistant",
          "when": "resourcePath =~ /edziegle\\.dear-reviewer\\/changes\\//",
          "group": "1_dearReviewer@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dearReviewer.openPullRequest",
          "when": "view == dearReviewer.inbox && viewItem == pullRequest",
          "group": "inline"
        },
        {
          "command": "dearReviewer.openPullRequest",
          "when": "view == dearReviewer.inbox && viewItem == pullRequest",
          "group": "open@1"
        },
        {
          "command": "dearReviewer.openLocalBranch",
          "when": "view == dearReviewer.inbox && viewItem == localBranch",
          "group": "inline"
        },
        {
          "command": "dearReviewer.openLocalBranch",
          "when": "view == dearReviewer.inbox && viewItem == localBranch",
          "group": "open@1"
        },
        {
          "command": "dearReviewer.markViewed",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^(file\\.unviewed|directory|change)$/",
          "group": "viewed@1"
        },
        {
          "command": "dearReviewer.unmarkViewed",
          "when": "view == dearReviewer.changeFiles && viewItem =~ /^(file\\.viewed|directory|change)$/",
          "group": "viewed@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "dearReviewer.addComment",
          "group": "inline",
          "when": "commentController == dearReviewer.review && commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "dearReviewer.editComment",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && comment == pending"
        },
        {
          "command": "dearReviewer.deleteComment",
          "group": "inline@2",
          "when": "commentController == dearReviewer.review && comment == pending"
        }
      ],
      "comments/comment/context": [
        {
          "command": "dearReviewer.cancelEditComment",
          "group": "inline@1",
          "when": "commentController == dearReviewer.review && comment == pending"
        },
        {
          "command": "dearReviewer.saveComment",
          "group": "inline@2",
          "when": "commentController == dearReviewer.review && comment == pending"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dearReviewer.inbox",
        "when": "dearReviewer.inboxWelcome == signedOut",
        "contents": "Sign in to GitHub to see the pull requests awaiting your review and the ones you authored.\n[Sign In to GitHub](command:dearReviewer.signIn)\nIf VS Code's GitHub sign-in isn't available, use a personal access token instead.\n[Use a Personal Access Token](command:dearReviewer.setToken)\n[Set up Dear Reviewer](command:dearReviewer.openSetup) step by step."
      },
      {
        "view": "dearReviewer.inbox",
        "when": "dearReviewer.inboxWelcome == noRepositories",
        "contents": "The Inbox lists pull requests from the GitHub repositories you have open in VSCodium. Open a folder that is a clone of a GitHub repository, or add a clone from elsewhere on this machine.\n[Add Repository](command:dearReviewer.addRepository)\n[Open Folder](command:vscode.openFolder)\nYou can also list repositories in the [Repositories setting](command:workbench.action.openSettings?%22dearReviewer.repositories%22), or [Set up Dear Reviewer](command:dearReviewer.openSetup) step by step."
      },
      {
        "view": "dearReviewer.inbox",
        "when": "dearReviewer.inboxWelcome == noRepositories && !isWorkspaceTrusted",
        "contents": "This window is in Restricted Mode, so Dear Reviewer doesn't read the repositories of its folders.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      },
      {
        "view": "dearReviewer.changeFiles",
        "contents": "No Change is open in this window. Open a pull request or a local branch from the Inbox with a click, or open any commit range of a repository as a Change.\n[Open Change](command:dearReviewer.openChange)"
      }
    ],
    "walkthroughs": [
      {
        "id": "setup",
        "title": "Set Up Dear Reviewer",
        "description": "From installing Dear Reviewer to submitting your first Review, without editing settings.",
        "steps": [
          {
            "id": "signIn",
            "title": "Sign in to GitHub",
            "description": "Dear Reviewer uses VS Code's GitHub sign-in to list your pull requests, comment and submit Reviews.\n[Sign In to GitHub](command:dearReviewer.signIn)\nWhere that sign-in isn't available, [use a personal access token](command:dearReviewer.setToken) instead; it is kept in the OS keychain.",
            "media": {
              "image": "media/dear-reviewer.svg",
              "altText": "The Dear Reviewer icon"
            },
            "completionEvents": [
              "onContext:dearReviewer.signedIn"
            ]
          },
          {
            "id": "repositories",
            "title": "Open your repositories",
            "description": "Every folder open in VSCodium that is a clone of a GitHub repository adds that repository to the Inbox, with the folder as its clone. Dear Reviewer remembers it, so the review window's Inbox lists it too. Add a clone you don't have open, or forget one, from the Inbox's toolbar.\n[Add Repository](command:dearReviewer.addRepository)",
            "media": {
              "image": "media/dear-reviewer.svg",
              "altText": "The Dear Reviewer icon"
            },
            "completionEvents": [
              "onContext:dearReviewer.hasRepositories"
            ]
          },
          {
            "id": "claude",
            "title": "Check the Assistant's Claude login",
            "description": "The Assistant runs the claude CLI you already have, with its own login: install Claude Code and sign in by running claude in a terminal. Point the Claude Path setting at it if it isn't on the PATH.\n[Check Claude Login](command:dearReviewer.checkClaudeLogin)",
            "media": {
              "image": "media/dear-reviewer.svg",
              "altText": "The Dear Reviewer icon"
            },
            "completionEvents": [
              "onContext:dearReviewer.claudeSignedIn"
            ]
          },
          {
            "id": "review",
            "title": "Review a pull request",
            "description": "Click a pull request in the Inbox to open it as a Change, in the review window. The first time, the review window opens in Restricted Mode: trust Dear Reviewer's folder of Changes once to turn on language servers and navigation. Comment in the diff's gutter, then submit your Review.\n[Show the Inbox](command:dearReviewer.inbox.focus)",
            "media": {
              "image": "media/dear-reviewer.svg",
              "altText": "The Dear Reviewer icon"
            },
            "completionEvents": [
              "onCommand:dearReviewer.openPullRequest",
              "onCommand:dearReviewer.openChange"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "markdown-it": "^15.0.2",
    "sanitize-html": "^2.18.0"
  }
}
